  "supplements": {
    "ECO-007": {
      "fields": {
        "形象與空間": "地表巨大菌株、地下根部的沉韻之庭與懸掛冠繭須分開理解；菌王集合意識寄居／凝聚於冠繭。冠繭不等同整株地表巨菌。"
      },
      "source": {
        "url": "https://docs.google.com/document/d/1YJ61U2Nn5KLwvWrqYnzy-mriwn6Uyo6zHeOKCoe0tsg/edit",
        "decision": "LB-071",
        "status": "A",
        "publication": "Session04 user-approved public scope; Bible sync pending"
      }
    },
    "GEO-011": {
      "fields": {
        "空間結構": "第四層眠孢庭的古代建築群被菌類改造，形成整體繭房；中央古代建築內設有獨立蘑丘核心穩定器設備區。共鳴腔室與機械設備區分開，外圍孢絲沿建築與廊道環繞。精確布局與尺度尚未確認。"
      },
      "source": {
        "url": "https://docs.google.com/document/d/1U78bMd1SYi8Xr5lxAZG8Ds5iGoNXw4OeGesG5yjRFfY/edit",
        "decision": "LB-070",
        "status": "A",
        "publication": "Session04 user-approved public scope; Bible sync pending"
      }
    },
    "GEO-012": {
      "fields": {
        "空間關係": "設備區位於群息之庭整體繭房中的中央古代建築內，維持獨立機械設備身分；與沉韻之庭為不同場所。"
      },
      "source": {
        "url": "https://docs.google.com/document/d/1U78bMd1SYi8Xr5lxAZG8Ds5iGoNXw4OeGesG5yjRFfY/edit",
        "decision": "LB-070",
        "status": "A",
        "publication": "Session04 user-approved public scope; Bible sync pending"
      }
    }
