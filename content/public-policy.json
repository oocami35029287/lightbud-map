  "excerpts": {
    "WRD-001": {
      "類別": "世界。",
      "定義": "古語意為「遺留之境」。古代共振能失控災變後仍有生物與社群存續的世界。",
      "世界狀態": "古代都市與基礎設施部分遺留，菌類及其他生命重新形成生態與聚落。世界本身並未碎裂成漂浮的虛空碎片。"
    },
    "WRD-002": {
      "類別": "世界。",
      "定義": "璃璃原本生活的世界，有她的家人與日常生活。",
      "魔素環境": "缺乏艾菲拉所具有的魔素條件，會影響跨界倉鼠族的體型與高階認知。"
    },
    "HIS-001": {
      "類別": "文明時期。",
      "定義": "艾菲拉大規模災變之前，擁有城市、交通、工業與能源技術的文明。",
      "技術": "利用機械結構與量子相關研究控制「共振能」，建立穩定器及其防護設備；此時的技術運作不依賴當代孢靈。",
      "都市演變": "古代都市曾在不同時代逐層向上擴建，形成後來遺構之森的四層疊構。"
    },
    "HIS-002": {
      "類別": "歷史事件。",
      "定義": "前文明時期發生的大規模共振能失控，破壞城市及生存環境，造成文明衰敗與人口大量損失。",
      "後果": "倖存者離散遷移，遺留都市逐漸受到植物與菌類覆蓋。",
      "名稱": "後世通稱「大裂潮」，正式歷史名稱為「大失相災變」。"
    },
    "HIS-003": {
      "類別": "歷史變化。",
      "定義": "災後倖存者曾繼續維護前文明設備；因人口死亡、流離與社會分化，原有維護體系逐步衰退。",
      "設備延續": "前文明穩定器在災變期間轉為緊急維持用途，並延續到當代。"
    },
    "HIS-004": {
      "類別": "歷史生態變化。",
      "定義": "災後數十年間，能適應與利用魔素的菌類迅速演化，其孢絲逐步接入仍在運作的古代設備。",
      "結果": "生命構成的菌網承接魔素輸送、訊號傳遞與跨地分流，與人工穩定器形成互相依存的系統。"
    },
    "HIS-005": {
      "類別": "歷史生物變化。",
      "定義": "災後倖存人群受到各地魔素與生態生命律動的長期共鳴影響，分化出具有不同身體特徵的族群。",
      "傳承": "地域分化形成的外形特徵可以遺傳。不同族群具有共同的人類祖源與跨族生育相容性；後代外貌通常以一方的主要形態為主，兼有少量混合特徵。現代穩定環境中的個體不會因為短暫跨地旅行立即改變族群形態。"
    },
    "MAG-001": {
      "類別": "能量。",
      "定義": "「共振能」是前文明對同一能源體系的工程總稱；古代分為原生共振能（天然未調質）、定頻共振能（穩定可利用）及失相共振能（失衡）。現代居民稱穩定可用狀態為「魔素」，稱失衡而具侵蝕風險的狀態為「暗魔素」。",
      "功能": "穩定魔素參與生命、生態與古代設備運作，可經菌網輸送和分流，並作為生命節律及菌類訊號的傳遞、增強媒介。"
    },
    "MAG-002": {
      "類別": "生命固有律動。",
      "定義": "生命自身具有的靈律，包含空相律、構相律、塑相律、迴相律四個基礎面向；一般生命均有固有生命動態與不同程度的共鳴潛能，當代四律代表主要可用操作模式；不能保證每個生命都有四個可獨立施法的本徵通道。",
      "普遍性": "生命普遍具有靈律與不同程度的共鳴能力；擅長的面向與能做到的事各不相同。",
      "與魔素的關係": "四律在沒有魔素時仍存在；魔素可傳遞與放大生命共鳴，施法者須依自願媒介釋出的魔素施術。"
    },
    "MAG-003": {
      "類別": "基礎律。",
      "定義": "擅長與其他生命的律動建立深入共鳴，依「感知→擬合→交流→自願協作」理解生命狀態、情緒與有限意圖。"
    },
    "MAG-004": {
      "類別": "基礎律。",
      "定義": "識別、組織不同律動與魔素之間的結構關係，可形成可見魔法陣、結界、屏障及短暫承重的魔素構造。"
    },
    "MAG-005": {
      "類別": "基礎律。",
      "定義": "藉魔素作用於既存物體，協助移動、旋轉、拆解、有限形變或重新組裝，與工匠機械技能可相互合作。"
    },
    "MAG-006": {
      "類別": "基礎律。",
      "定義": "以生命既有的健康律動或可辨識的穩定基準作為參照，幫助維持、減緩偏離，並促進仍具修復條件的生命組織癒合與生理機能恢復；可呈現環形脈動、節律殘影與收束光線。"
    },
    "ECO-001": {
      "類別": "菌類生命階段。",
      "定義": "息孢是菌類生命的游離階段；一般個體在合適基質定著後成為持續生長的孢絲生命。少數具特殊生理適性的個體可長期維持游離形態並逐步成熟，不以聰明程度單獨決定能否游離。",
      "感受": "息孢為有自主意識與感受的獨立生命，可自願與其他生命共鳴並拒絕協作。",
      "環境活動": "一般息孢短期游離，可選擇性吸收、暫存、釋出有限穩定魔素，部分呈漂浮或發光外觀。"
    },
    "ECO-002": {
      "類別": "菌類成熟生命。",
      "定義": "菌材統稱孢絲生命持續生長形成的菌實、菌木、菌膜等器官與構造；它們與原有孢絲生命相連，可能依個體生理及環境條件生長、脫落或被合作採收，不是另有完整獨立人格的成熟菌類生命。",
      "集群": "菌材是生命生長的器官與構造；多個孢絲生命持續連結，才可能形成具有集合意識的菌簇。"
    },
    "ECO-003": {
      "類別": "菌類生命結構。",
      "定義": "一般息孢定著於合適基質後可形成孢絲生命，原有孢絲不因後續形成成熟器官而必然消失；孢絲可沿土壤、遺構、牆面、根系與裂隙伸展。",
      "功能": "孢絲可參與魔素、生命狀態及共鳴訊號傳遞，並持續生長出菌實、菌木與菌膜等器官。"
    },
    "ECO-004": {
      "類別": "菌類集合生命。",
      "定義": "多個孢絲生命透過持續連結可以形成菌簇，出現集中、統合的群體意識；並非每個個體生命都必經菌簇階段。"
    },
    "ECO-005": {
      "類別": "生命與能量傳輸系統。",
      "定義": "由具傳輸能力的特殊菌類與孢絲連結構成的功能性網路，負責魔素、生命狀態及共鳴訊號的流通與分流。",
      "結構": "連結菌王的協調核心、不同區域的感知交流場所與四座古代穩定器。",
      "特性": "魔素網路連線不等於人物可行走的道路。"
    },
    "ECO-006": {
      "類別": "世界生命網路。",
      "定義": "連結艾菲拉各地菌類生命及其魔素交換的整體網路，可類比遍布世界的神經系統。",
      "分工": "由菌王協調生命與感知訊號；孢絲負責輸送與分流；菌網儲能結節可暫存、緩衝與釋放魔素；人工穩定器控制流量、壓力與頻率。"
    },
    "ECO-007": {
      "類別": "菌類集合意識。",
      "定義": "菌王由龐大的菌類生命集群構成，是菌網生命訊號協調的中樞，集中意識與組成生命的個體感受並存。",
      "能力界線": "能協調菌網與生命訊號，不具將暗魔素淨化為穩定魔素的植物調質能力，亦不能遠距替居民修好古代機械。",
      "形象與空間": "地表巨大菌株、第五層菌株根部的菌王深庭與庭中懸掛的冠繭，是同一生命系統中不同的形象與空間。菌王集合意識凝聚於冠繭，不等同整株地表巨菌。"
    },
    "ECO-008": {
      "類別": "巨大生命體與魔素調和系統。",
      "定義": "位於艾瑟波恩的巨大澄樹，與全域菌網及北方穩定器存在生態協作；樹冠覆蓋城邦，主幹、粗枝與氣根承載依樹而建的生活空間。",
      "功能": "聖樹為澄脈屬中高效的生物調質者；只有澄脈屬植物能主動把暗魔素轉為較穩定魔素，普通其他植物與孢靈生命不具此能力。",
      "地理": "古災變的地層差異抬升先形成岩層高地；後世聖樹的巨大主幹、根系與氣根街區塑造現代依樹城邦，樹冠蔭蔽居民生活區。高地地質成因與聖樹後期生長分屬不同時代。"
    },
    "ECO-009": {
      "類別": "沼原牧畜。",
      "定義": "由深境沼原居民照顧的動物，性情溫馴、親人且黏人。"
    },
    "GEO-001": {
      "類別": "聚落與地理層級。",
      "定義": "位於四層古代都市上方、由菌類生態覆蓋與人群生活構成的聚落，屬於現代地理上的第五層。",
      "生活": "有家庭住宅、共生菌屋、孢田溫室、聚會及交易活動。菌屋可以由自願協作的孢絲生命生長成型，或用已採收加工的菌材建造，居民提供水分、養分、清理與保護。",
      "交通": "透過橋梁銜接鄰近風棲原的古代高樓上部，接入高地走廊。"
    },
    "GEO-002": {
      "類別": "前文明城市遺構區。",
      "定義": "多個時代逐次向上擴建、現已與菌林交織的四層大型古代城市區域。四層表示都市遺構的垂直結構。",
      "地理關係": "蘑丘覆蓋其第四層部分區域；第一層與自然基準地表約在同一高度。",
      "魔素環境": "沿古代城市結構向下深入，魔素負荷逐漸升高。",
      "層級": "古代都市有四個物理樓層；蘑丘的現代生活地表在其上方，稱為第五層。"
    },
    "GEO-003": {
