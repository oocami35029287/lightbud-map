  {
    "id": "ECO-004",
    "name": "菌簇",
    "fields": {
      "類別": "菌類集合生命。",
      "定義": "多個孢絲生命透過持續連結可以形成菌簇，出現集中、統合的群體意識；並非每個個體生命都必經菌簇階段。"
    },
