  {
    "id": "ECO-002",
    "name": "菌材",
    "fields": {
      "類別": "菌類成熟生命。",
      "定義": "菌材統稱孢絲生命持續生長形成的菌實、菌木、菌膜等器官與構造；它們與原有孢絲生命相連，可能依個體生理及環境條件生長、脫落或被合作採收，不是另有完整獨立人格的成熟菌類生命。",
      "集群": "菌材是生命生長的器官與構造；多個孢絲生命持續連結，才可能形成具有集合意識的菌簇。"
    },
    "status": "A",
    "visibility": "public",
    "source": {
      "url": "https://github.com/oocami35029287/lightbud-dream/blob/8635e92887732ac49dd46d6776878648e6cdedef/world-bible/WORLD_BIBLE.md",
