[
  {
    "id": "ECO-001",
    "name": "息孢",
    "fields": {
      "類別": "菌類生命階段。",
      "定義": "息孢是菌類生命的游離階段；一般個體在合適基質定著後成為持續生長的孢絲生命。少數具特殊生理適性的個體可長期維持游離形態並逐步成熟，不以聰明程度單獨決定能否游離。",
      "感受": "息孢為有自主意識與感受的獨立生命，可自願與其他生命共鳴並拒絕協作。",
      "環境活動": "一般息孢短期游離，可選擇性吸收、暫存、釋出有限穩定魔素，部分呈漂浮或發光外觀。"
    },
    "status": "A",
    "visibility": "public",
    "source": {
      "url": "https://github.com/oocami35029287/lightbud-dream/blob/8635e92887732ac49dd46d6776878648e6cdedef/world-bible/WORLD_BIBLE.md",
