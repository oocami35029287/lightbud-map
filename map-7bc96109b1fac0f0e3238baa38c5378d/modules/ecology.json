  {
    "id": "ECO-005",
    "name": "魔素網路",
    "fields": {
      "類別": "生命與能量傳輸系統。",
      "定義": "由具傳輸能力的特殊菌類與孢絲連結構成的功能性網路，負責魔素、生命狀態及共鳴訊號的流通與分流。",
      "結構": "連結菌王的協調核心、不同區域的感知交流場所與四座古代穩定器。",
      "特性": "魔素網路連線不等於人物可行走的道路。"
    },
    "status": "A",
    "visibility": "public",
