    "id": "ECO-002",
    "name": "菌精",
    "fields": {
      "類別": "菌類成熟生命。",
      "定義": "由孢靈成長而來的菌類生命，具有多種不同功能與形態，可經居民培養，也可自然生長。",
      "集群": "菌精之間可以成簇、形成連結，產生更大的菌類生命結構。"
    },
    "status": "A",
    "visibility": "public",
