  {
    "id": "GEO-001",
    "name": "蘑丘",
    "fields": {
      "類別": "聚落與地理層級。",
      "所屬世界": "WRD-001。",
      "定義": "位於四層古代都市上方、由菌類生態覆蓋與人群生活構成的聚落，屬於現代地理上的第五層。",
      "生活": "有家庭住宅、普通農務、孢田溫室、聚會及交易活動。",
      "交通": "透過橋梁銜接鄰近風棲原的古代高樓上部，接入高地走廊。"
    },
    "status": "A",
    "visibility": "public",
