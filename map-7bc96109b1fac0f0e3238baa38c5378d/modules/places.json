[
  {
    "id": "GEO-001",
    "name": "蘑丘",
    "fields": {
      "類別": "聚落與地理層級。",
      "定義": "位於四層古代都市上方、由菌類生態覆蓋與人群生活構成的聚落，屬於現代地理上的第五層。",
      "生活": "有家庭住宅、共生菌屋、孢田溫室、聚會及交易活動。菌屋可以由自願協作的孢絲生命生長成型，或用已採收加工的菌材建造，居民提供水分、養分、清理與保護。",
      "交通": "透過橋梁銜接鄰近風棲原的古代高樓上部，接入高地走廊。"
    },
    "status": "A",
    "visibility": "public",
    "source": {
      "url": "https://github.com/oocami35029287/lightbud-dream/blob/8635e92887732ac49dd46d6776878648e6cdedef/world-bible/WORLD_BIBLE.md",
