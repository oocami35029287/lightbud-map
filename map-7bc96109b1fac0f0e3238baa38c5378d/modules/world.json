  {
    "id": "HIS-003",
    "name": "災後維護體系衰退",
    "fields": {
      "類別": "歷史變化。",
      "定義": "災後倖存者曾繼續維護前文明設備；因人口死亡、流離與社會分化，原有維護體系逐步衰退。",
      "設備延續": "前文明穩定器在災變期間轉為緊急維持用途，並延續到當代。"
    },
    "status": "A",
