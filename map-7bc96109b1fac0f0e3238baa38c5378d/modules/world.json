  {
    "id": "HIS-002",
    "name": "大裂潮",
    "fields": {
      "類別": "歷史事件。",
      "定義": "前文明時期發生的大規模共振能失控，破壞城市及生存環境，造成文明衰敗與人口大量損失。",
      "後果": "倖存者離散遷移，遺留都市逐漸受到植物與菌類覆蓋。",
      "名稱": "後世通稱「大裂潮」，正式歷史名稱為「大失相災變」。"
    },
    "status": "A",
    "visibility": "public",
